# Generate a fresh random token with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Operator/bootstrap secret; browsers only store independently issued, eight-hour sessions.
# Rotate this configuration and restart if the operator secret is compromised.
GCB_AUTH_TOKEN=replace-with-a-unique-secret-of-at-least-24-characters
HOST=127.0.0.1
# Only literal IPs accepted. Defaults to loopback. DO NOT enable remote binds on an
# unreviewed instance: it requires a separate HTTPS, access, network and identity gate.
# For an explicitly reviewed non-loopback deployment, set GCB_ALLOW_NON_LOOPBACK=1.
GCB_ALLOW_NON_LOOPBACK=0
PORT=4173
GCB_DATA_FILE=./data/bookmarks.json
GCB_BACKUP_DIR=./backups

# Optional comma-separated exact Host headers for a trusted reverse proxy.
# Supply ASCII hostnames only (punycode when necessary), without scheme or port.
# Empty means localhost, 127.0.0.1 and [::1] only.
# Example: GCB_TRUSTED_HOSTS=bookmarks.example.org
GCB_TRUSTED_HOSTS=
