{
  "manifest_version": 3,
  "name": "GoreeCloud Bookmarks — Save Link",
  "version": "0.1.15",
  "description": "Save the current tab to your private local GoreeCloud Bookmarks library.",
  "action": {
    "default_title": "Save to GoreeCloud Bookmarks",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:4173/*", "http://localhost:4173/*"],
  "minimum_chrome_version": "102"
}
