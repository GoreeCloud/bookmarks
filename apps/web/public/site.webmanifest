{
  "id": "/dashboard",
  "name": "GoreeCloud Bookmarks",
  "short_name": "Bookmarks",
  "icons": [
    {
      "src": "/goreecloud-bookmarks-mark.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/api/v1/links/",
