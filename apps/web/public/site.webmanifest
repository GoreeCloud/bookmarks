    "enctype": "multipart/form-data",
    "params": {
      "url": "link"
    }
  },
  "theme_color": "#11233b",
  "background_color": "#11233b",
  "display": "standalone",
  "orientation": "portrait",
  "start_url": "/dashboard",
  "description": "Private knowledge capture, preservation and retrieval"
}
